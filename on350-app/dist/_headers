# Security headers for on350.com (Cloudflare Workers static assets). The script hash is the small theme script in
# index.html; if that script changes, update the hash (scripts/check-csp.mjs prints the right one after a build).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-47MMcf1zEUV1bx0pPPcA9EY2kF8pYA9p7MhXIYzk+UI=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://zikseitbcvmkuljmbpxs.supabase.co; media-src 'self' blob: https://zikseitbcvmkuljmbpxs.supabase.co; font-src 'self' data:; connect-src 'self' https://zikseitbcvmkuljmbpxs.supabase.co wss://zikseitbcvmkuljmbpxs.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/downloads/cookbook.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="On350.apk"
/.well-known/assetlinks.json
  Content-Type: application/json
