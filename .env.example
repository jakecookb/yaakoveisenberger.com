# ─────────────────────────────────────────────────────────────────────────────
# yaakoveisenberger.com/fund — environment variables
# Copy to .env.local for local dev, and add the same keys in Vercel → Settings →
# Environment Variables. `npm run fund:setup` fills in the Stripe webhook secrets.
# Anything left blank degrades gracefully (see README → "What happens if…").
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL — used for QR codes, share links, Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://yaakoveisenberger.com

# Supabase (Project Settings → API / API Keys). Either new publishable/secret keys
# or the legacy anon/service_role keys work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SECRET_KEY=sb_secret_...            # server only — never expose
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: lets `npm run fund:setup` apply the migration and set the auth redirect URL.
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_ACCESS_TOKEN=

# Super admins: these emails are promoted to platform admin on first sign-in.
FUND_PLATFORM_ADMIN_EMAILS=you@example.com

# Stripe (dashboard.stripe.com/apikeys). Enable Connect (Express) first.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...              # platform events (created by fund:setup)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...      # connected-account events (created by fund:setup)

# Optional: Cloudflare Turnstile bot check on checkout (skipped when blank).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional tuning (defaults shown)
# FUND_STRIPE_FEE_PERCENT=2.9              # used for "cover the fees" gross-up
# FUND_STRIPE_FEE_FIXED_CENTS=30
# FUND_ORG_PAYS_PROCESSING_FEES=true       # false = platform absorbs Stripe fees from its cut
# FUND_LARGE_GIFT_REVIEW_CENTS=1000000     # gifts >= $10,000 are flagged for review
# FUND_STRIPE_CONNECT_COUNTRY=US
# FUND_STRIPE_DIRECT_CHARGES_FALLBACK=false  # true = accept gifts before a nonprofit finishes Connect (funds stay on platform)
# NEXT_PUBLIC_FUND_ENABLE_DEMO=false       # true = keep /fund/demo available in production
